# MongoDB (deployment must support Vector Search)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=coldchain_copilot

# Embeddings for documents and queries: provider (voyage, openai) and model.
# Rerun scripts/ingest_docs.py after changing either.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4

# Chat model for the agent, as provider:model (LangChain init_chat_model format).
# The model must support tool calling. Reasoning effort applies to OpenAI models only.
LLM_MODEL=openai:gpt-6.1-terra
LLM_REASONING_EFFORT=low

# API keys, read under each provider's own name. Set the ones your providers need.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Optional: LangSmith tracing of every agent run (no code involved; LangChain reads these)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=coldchain-copilot

# Max window for fleet- or reefer-scoped sensor queries; matches the 72h history seed.py writes
MAX_WINDOW_HOURS=72

# Catalog JSON and source documents (relative to the working directory)
DATA_DIR=data
DOCS_DIR=docs
